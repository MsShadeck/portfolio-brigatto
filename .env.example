# URL pública do site — usada para SEO (sitemap.xml, tags Open Graph com URL absoluta).
# Dev: deixe como está. Produção: a URL final do domínio (ex.: https://seusite.com.br).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados
# Dev: SQLite local (arquivo). Produção: string de conexão Postgres (Neon/Supabase).
DATABASE_URL="file:./dev.db"

# Auth.js
# Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-valor-aleatorio-seguro"

# Credenciais do usuário admin criado pelo script de seed (prisma/seed.ts)
ADMIN_NOME="Nome do Videomaker"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# Upload de imagens (Vercel Blob) — necessário para thumbnails, logos e foto de perfil.
# Gerado automaticamente ao conectar um Blob store no projeto na Vercel,
# ou via `vercel blob store add` localmente.
BLOB_READ_WRITE_TOKEN=""

# (Opcional) Notificação por e-mail das mensagens de contato via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
